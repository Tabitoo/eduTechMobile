<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="vertical"
android:id="@+id/menu"
android:gravity="center"
android:padding="24dp"
tools:context="com.unlam.edutechapp.fragments.MenuFragment">

<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/bienvenido_a_edutech"
    android:textSize="26sp"
    android:textStyle="bold"
    android:layout_marginBottom="40dp" />

<Button
    android:id="@+id/btnCursosDisponibles"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/cursos_disponibless"
    android:layout_marginBottom="20dp" />

<Button
    android:id="@+id/btnMisCursos"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/mis_cursos" />

</LinearLayout>
